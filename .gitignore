# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore real secrets, keep the example template committed
.env*
!.env.local.example

# stray logs
.npm-install.log

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
screens/
/dist/
.vinext/
.cloudflare/

# generated social-card derivatives — rebuilt by `npm run social-cards:generate`
# (see .github/workflows/deploy-cloudflare-staging.yml). The manifest that the
# route imports is committed as a placeholder so the build always resolves it.
/public/social/cards/*.webp
/public/social/cards/manifest.json

# Android shell build artifacts and signing material (never commit secrets)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
*.jks
*.keystore
evidence/build-output/
