<?xml version="1.0" encoding="utf-8"?>
<!--
  Android TV flavour (Track 3C). Obligations:
    - leanback required="true"  (so Play only serves it to TV devices)
    - no touchscreen requirement (a TV has none; requiring it hides the app)
    - 320x180 banner via android:banner
    - LEANBACK_LAUNCHER intent filter so it appears on the TV home row
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher" />

    <activity
        android:name=".MainActivity"
        android:exported="true">

        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>

    </activity>

</manifest>
