# Get a free key at https://unsplash.com/developers (create an app, copy the "Access Key").
# Without this set, MediaFrame falls back to its generative gradient placeholder automatically.
UNSPLASH_ACCESS_KEY=

# Optional: a published Spline scene URL (…/scene.splinecode). When set, it
# replaces the WebGL halftone in the hero. Leave blank to use the halftone.
# See README → "Adding a Spline 3D scene" for how to export this from Spline.
NEXT_PUBLIC_SPLINE_SCENE=
