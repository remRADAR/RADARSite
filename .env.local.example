# Get a free key at https://unsplash.com/developers (create an app, copy the "Access Key").
# Without this set, MediaFrame falls back to its generative gradient placeholder automatically.
UNSPLASH_ACCESS_KEY=

# Sentry DSN for browser, server, and edge exception reporting.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# GA4 measurement ID. Set this in Vercel Production/Preview to enable
# pageview and route-change analytics across the entire site.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Google Search Console HTML verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: a published Spline scene URL (…/scene.splinecode). When set, it
# replaces the WebGL halftone in the hero. Leave blank to use the halftone.
# See README → "Adding a Spline 3D scene" for how to export this from Spline.
NEXT_PUBLIC_SPLINE_SCENE=

# Shared Studio persistence — Neon Postgres is the live CMS/settings store. Set
# these in local development and Vercel Production/Preview environments. When
# DATABASE_URL is absent, Studio explicitly runs in browser-only fallback mode;
# those edits are not published to public server-rendered pages.
DATABASE_URL=
STUDIO_ADMIN_PASSWORD=

# Server-only Cloudflare R2 storage for hosted media and WebP derivatives.
# Configure these in Vercel Production/Preview environments; never expose them
# through NEXT_PUBLIC_* variables or client-side code.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=radarsite-media
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Optional server-only authorization header for current WordPress media fetches.
# Example: Bearer <token>. Never expose this as NEXT_PUBLIC_*.
WORDPRESS_MEDIA_AUTHORIZATION=

# Shared secret used only by the Cloudflare daily cache-maintenance Worker.
# Store the same secret in the deployed Worker as RADARSITE_CACHE_MAINTENANCE_TOKEN.
CACHE_MAINTENANCE_TOKEN=

# Notion -> RADARSite publishing (server-only; disabled unless explicitly enabled).
# Ask the Notion workspace owner to create/share an internal connection with read
# and update-content access to the existing editorial data source only. Supply its
# secret token, the verified data-source ID, and a separately generated webhook
# bearer secret. Keep all values in Vercel Preview first; never use NEXT_PUBLIC_*.
NOTION_API_KEY=
RADAR_NOTION_DATA_SOURCE_ID=
RADAR_NOTION_SYNC_SECRET=
# Keep false until preview auth, schema, dry-run, and publishing tests are approved.
RADAR_NOTION_PUBLISHING_ENABLED=false
# Number of reverse proxies that this deployment controls. Set this before
# enabling proxy-aware rate limiting; leave at 0 when forwarded headers are not
# stripped and rewritten by a trusted edge.
RADAR_TRUSTED_PROXY_HOPS=1
